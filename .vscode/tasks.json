{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Test (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}\\test",
                "-B",
                "${workspaceFolder}\\test\\build\\debug",
                "-DMWINDOWS_TEST_CONFIGURATION=Debug"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Test (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}\\test\\build\\debug",
                "--config",
                "Debug"
            ],
            "dependsOn": "CMake: Configure Test (Debug)",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Configure Test (Release)",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}\\test",
                "-B",
                "${workspaceFolder}\\test\\build\\release",
                "-DMWINDOWS_TEST_CONFIGURATION=Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "CMake: Build Test (Release)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}\\test\\build\\release",
                "--config",
                "Release"
            ],
            "dependsOn": "CMake: Configure Test (Release)",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
